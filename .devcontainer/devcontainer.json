// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "Stillroom Dev Container",
	"build": { "context": "..", "dockerfile": "Dockerfile" },
	"forwardPorts": [8000, 8080, 5173],
	"portsAttributes": {
		"8000": { "label": "Django" },
		"8080": { "label": "Gunicorn" },
		"5173": { "label": "Vite" }
	},
	"remoteUser": "root",
	"updateRemoteUserUID": false,
	"overrideCommand": true,
	// Keep Vue native bindings (rolldown/vite) Linux-only. A host bind-mount
	// would otherwise overlay Windows/macOS node_modules into the container.
	"mounts": [
		"source=stillroom-vue3-node-modules,target=${containerWorkspaceFolder}/vue3/node_modules,type=volume"
	],
	"onCreateCommand": "bash .devcontainer/setup-frontend.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.debugpy",
				"ms-python.python"
			]
		}
	},
	"containerEnv": {
		"CSRF_TRUSTED_ORIGINS": "http://localhost:8000,http://localhost:8080"
	},
	// Cursor copies host gitconfig; drop host-only ssh/signing binaries so the
	// forwarded SSH agent is used instead.
	"postStartCommand": "git config --global --unset-all gpg.ssh.program || true; git config --global --unset-all core.sshCommand || true"
}
